# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (required for database mode; omit to use the in-memory fallback)
MONGODB_URI=
MONGODB_DB=

# JWT signing secret (set a long random value in production)
JWT_SECRET=

# Public origin of the app (used in password reset links)
CLIENT_URL=

# SMS / OTP delivery (SMS_PROVIDER: auto | fast2sms | twilio | 2factor)
SMS_PROVIDER=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWOFACTOR_API_KEY=

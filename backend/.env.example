# Server Configuration
PORT=5000

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=vednetra
PGUSER=postgres
PGPASSWORD=postgres

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Authentication JWT Secret
JWT_SECRET=vednetra_sacred_jwt_token_key_2026_shree_ganesh

# SMS Gateway Configuration for Mobile OTP Delivery
# Supported providers: fast2sms | twilio | 2factor | auto
SMS_PROVIDER=auto

# 1. Fast2SMS (Recommended for India - https://www.fast2sms.com)
# Get free API Key from Fast2SMS Dev API dashboard
FAST2SMS_API_KEY=

# 2. Twilio (Global SMS Gateway - https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# 3. 2Factor.in (https://www.2factor.in)
TWOFACTOR_API_KEY=
